{
  "name": "atlas-agency",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Atlas Agency — gestão de campanhas e mobilização digital",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node -e \"require('./server/db').getDb().then(db => require('./server/seed').seed(db))\"",
    "logos:sync": "node scripts/sync-logos.js",
    "install:all": "npm install && npm install --prefix client",
    "docker:build": "docker build -t atlas-agency .",
    "docker:run": "docker run --rm -p 3000:3000 atlas-agency"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^3.3.8",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.12.0",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
